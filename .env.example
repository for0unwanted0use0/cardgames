# Convex client URL (provided automatically during Convex/Vercel builds)
NEXT_PUBLIC_CONVEX_URL=

# Public Google Analytics 4 web-stream measurement ID (for example G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# LiveKit Cloud server-side configuration (also configure all three in Vercel Production)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
